{
  "name": "novellized-editor",
  "displayName": "Novellized Prose Editor",
  "description": "WYSIWYG Live Markdown Editor for Authors and Novelists in VS Code / VSCodium",
  "version": "0.1.0",
  "publisher": "novellized",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other",
    "Formatters"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCustomEditor:novellized.editor",
    "onView:novellized.manuscriptView",
    "onView:novellized.projectStatsView",
    "onView:novellized.bibleView"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "novellized-manuscript",
          "title": "Novellized Manuscript",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "novellized-manuscript": [
        {
          "id": "novellized.manuscriptView",
          "name": "Manuscript"
        },
        {
          "id": "novellized.projectStatsView",
          "name": "Writing Goals & Stats"
        },
        {
          "id": "novellized.bibleView",
          "name": "Story Bible & AI Context"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "novellized.editor",
        "displayName": "Novellized Live View",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "novellized.openAsRawMarkdown",
        "title": "Novellized: Open as Raw Markdown",
        "icon": "$(file-code)"
      },
      {
        "command": "novellized.openAsLiveView",
        "title": "Novellized: Open in Live View",
        "icon": "$(book)"
      },
      {
        "command": "novellized.createNewNovel",
        "title": "Novellized: Create New Novel Project...",
        "icon": "$(sparkle)"
      },
      {
        "command": "novellized.refreshManuscript",
        "title": "Novellized: Refresh Manuscript",
        "icon": "$(refresh)"
      },
      {
        "command": "novellized.addScene",
        "title": "Novellized: Add New Scene...",
        "icon": "$(plus)"
      },
      {
        "command": "novellized.addChapter",
        "title": "Novellized: Add New Chapter...",
        "icon": "$(new-folder)"
      },
      {
        "command": "novellized.setWordGoal",
        "title": "Novellized: Set Target Word Count",
        "icon": "$(target)"
      },
      {
        "command": "novellized.deleteScene",
        "title": "Novellized: Delete Scene",
        "icon": "$(trash)"
      },
      {
        "command": "novellized.importDocx",
        "title": "Novellized: Import Manuscript from Word (.docx)...",
        "icon": "$(cloud-download)"
      },
      {
        "command": "novellized.copyAiPrompt",
        "title": "Novellized: Copy AI Organization Prompt for Staged Document...",
        "icon": "$(sparkle)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "novellized.openAsRawMarkdown",
          "when": "activeCustomEditorId == 'novellized.editor'",
          "group": "navigation"
        },
        {
          "command": "novellized.openAsLiveView",
          "when": "resourceExtname == .md && activeCustomEditorId != 'novellized.editor'",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "novellized.refreshManuscript",
          "when": "view == novellized.manuscriptView || view == novellized.projectStatsView || view == novellized.bibleView",
          "group": "navigation"
        },
        {
          "command": "novellized.importDocx",
          "when": "view == novellized.manuscriptView",
          "group": "navigation"
        },
        {
          "command": "novellized.addChapter",
          "when": "view == novellized.manuscriptView",
          "group": "navigation"
        },
        {
          "command": "novellized.addScene",
          "when": "view == novellized.manuscriptView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "novellized.addScene",
          "when": "view == novellized.manuscriptView && viewItem == chapter",
          "group": "inline"
        },
        {
          "command": "novellized.addChapter",
          "when": "view == novellized.manuscriptView && viewItem == part",
          "group": "inline"
        },
        {
          "command": "novellized.openAsLiveView",
          "when": "view == novellized.manuscriptView && viewItem == scene",
          "group": "navigation"
        },
        {
          "command": "novellized.openAsRawMarkdown",
          "when": "view == novellized.manuscriptView && viewItem == scene",
          "group": "navigation"
        },
        {
          "command": "novellized.deleteScene",
          "when": "view == novellized.manuscriptView && viewItem == scene",
          "group": "9_cutcopypaste"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "novellized.manuscriptView",
        "contents": "No novel manuscript found in this workspace.\n[Create New Novel Project](command:novellized.createNewNovel)\n[📥 Import from Word (.docx)](command:novellized.importDocx)"
      },
      {
        "view": "explorer",
        "contents": "Start your literary project with Novellized.\n[Create New Novel Project](command:novellized.createNewNovel)"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "node esbuild.config.mjs --production",
    "compile": "tsc -noEmit",
    "watch": "node esbuild.config.mjs --watch",
    "build": "node esbuild.config.mjs --production"
  },
  "dependencies": {
    "@tiptap/core": "^2.11.5",
    "@tiptap/extension-bubble-menu": "^2.27.3",
    "@tiptap/extension-focus": "^2.27.3",
    "@tiptap/starter-kit": "^2.11.5",
    "mammoth": "^1.12.2",
    "tiptap-markdown": "^0.8.10"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "@types/vscode": "^1.80.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.3.3"
  }
}
