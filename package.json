{
  "name": "novellized-editor",
  "displayName": "Novellized Prose Editor",
  "description": "WYSIWYG Live Markdown Editor for Authors and Novelists in VS Code / VSCodium",
  "version": "0.1.0",
  "publisher": "novellized",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other",
    "Formatters"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onCustomEditor:novellized.editor",
    "onView:novellized.manuscriptView",
    "onView:novellized.projectStatsView",
    "onView:novellized.bibleView",
    "onView:novellized.sceneInspectorView"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "novellized-manuscript",
          "title": "Novellized Manuscript",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "novellized-manuscript": [
        {
          "id": "novellized.manuscriptView",
          "name": "Manuscript"
        },
        {
          "id": "novellized.projectStatsView",
          "name": "Writing Goals & Stats"
        },
        {
          "id": "novellized.bibleView",
          "name": "Story Bible & AI Context"
        },
        {
          "id": "novellized.sceneInspectorView",
          "name": "Scene Inspector"
        }
      ],
      "scm": [
        {
          "id": "novellized.snapshotHistoryView",
          "name": "Checkpoints & Snapshots"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "novellized.editor",
        "displayName": "Novellized Live View",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "novellized.openAsRawMarkdown",
        "title": "Novellized: Open as Raw Markdown",
        "icon": "$(file-code)"
      },
      {
        "command": "novellized.openAsLiveView",
        "title": "Novellized: Open in Live View",
        "icon": "$(book)"
      },
      {
        "command": "novellized.createNewNovel",
        "title": "Novellized: Create New Novel Project...",
        "icon": "$(sparkle)"
      },
      {
        "command": "novellized.refreshManuscript",
        "title": "Novellized: Refresh Manuscript",
        "icon": "$(refresh)"
      },
      {
        "command": "novellized.addScene",
        "title": "Novellized: Add New Scene...",
        "icon": "$(plus)"
      },
      {
        "command": "novellized.addChapter",
        "title": "Novellized: Add New Chapter...",
        "icon": "$(new-folder)"
      },
      {
        "command": "novellized.setWordGoal",
        "title": "Novellized: Set Target Word Count",
        "icon": "$(target)"
      },
      {
        "command": "novellized.deleteScene",
        "title": "Novellized: Delete Scene",
        "icon": "$(trash)"
      },
      {
        "command": "novellized.importDocx",
        "title": "Novellized: Import Manuscript from Word (.docx)...",
        "icon": "$(cloud-download)"
      },
      {
        "command": "novellized.copyAiPrompt",
        "title": "Novellized: Copy AI Organization Prompt for Staged Document...",
        "icon": "$(sparkle)"
      },
      {
        "command": "novellized.renameChapter",
        "title": "Novellized: Rename Chapter...",
        "icon": "$(edit)"
      },
      {
        "command": "novellized.renameScene",
        "title": "Novellized: Rename Scene...",
        "icon": "$(edit)"
      },
      {
        "command": "novellized.deleteChapter",
        "title": "Novellized: Delete Chapter",
        "icon": "$(trash)"
      },
      {
        "command": "novellized.exportEpub",
        "title": "Novellized: Export Manuscript as EPUB (.epub)...",
        "icon": "$(book)"
      },
      {
        "command": "novellized.exportPdf",
        "title": "Novellized: Export Manuscript as PDF (.pdf)...",
        "icon": "$(file-pdf)"
      },
      {
        "command": "novellized.previewPrintableBook",
        "title": "Novellized: Open Printable Book Preview (HTML / Print)",
        "icon": "$(eye)"
      },
      {
        "command": "novellized.toggleZenMode",
        "title": "Novellized: Toggle Zen Writing Mode (Distraction-Free)",
        "icon": "$(screen-full)"
      },
      {
        "command": "novellized.applyNovelistPreset",
        "title": "Novellized: Apply Writer's Settings Preset (Word Wrap, Clean Typography)",
        "icon": "$(gear)"
      },
      {
        "command": "novellized.openCorkboard",
        "title": "Novellized: Open Chapter Corkboard",
        "icon": "$(dashboard)"
      },
      {
        "command": "novellized.takeSnapshot",
        "title": "Novellized: Take Scene Snapshot...",
        "icon": "$(camera)"
      },
      {
        "command": "novellized.startWritingSprint",
        "title": "Novellized: Start Writing Sprint / Pomodoro...",
        "icon": "$(flame)"
      },
      {
        "command": "novellized.openSourceControl",
        "title": "Novellized: Open Source Control (Manuscript Versions & Checkpoints)",
        "icon": "$(source-control)"
      },
      {
        "command": "novellized.scmCommit",
        "title": "Novellized: Save Manuscript Checkpoint...",
        "icon": "$(check)"
      },
      {
        "command": "novellized.scmDiff",
        "title": "Novellized: Compare with Last Checkpoint",
        "icon": "$(git-compare)"
      },
      {
        "command": "novellized.scmDiscard",
        "title": "Novellized: Discard Changes (Revert to Checkpoint)",
        "icon": "$(discard)"
      },
      {
        "command": "novellized.refreshSnapshotHistory",
        "title": "Novellized: Refresh Checkpoints & Snapshots",
        "icon": "$(refresh)"
      },
      {
        "command": "novellized.compareSnapshotFile",
        "title": "Novellized: Compare File with Checkpoint",
        "icon": "$(git-compare)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "novellized.openAsRawMarkdown",
          "when": "activeCustomEditorId == 'novellized.editor'",
          "group": "navigation"
        },
        {
          "command": "novellized.openAsLiveView",
          "when": "resourceExtname == .md && activeCustomEditorId != 'novellized.editor'",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "novellized.refreshManuscript",
          "when": "view == novellized.manuscriptView || view == novellized.projectStatsView || view == novellized.bibleView",
          "group": "navigation@1"
        },
        {
          "command": "novellized.exportEpub",
          "when": "view == novellized.manuscriptView",
          "group": "navigation@2"
        },
        {
          "command": "novellized.exportPdf",
          "when": "view == novellized.manuscriptView",
          "group": "navigation@3"
        },
        {
          "command": "novellized.importDocx",
          "when": "view == novellized.manuscriptView",
          "group": "navigation@4"
        },
        {
          "command": "novellized.addChapter",
          "when": "view == novellized.manuscriptView",
          "group": "navigation@5"
        },
        {
          "command": "novellized.addScene",
          "when": "view == novellized.manuscriptView",
          "group": "navigation@6"
        },
        {
          "command": "novellized.startWritingSprint",
          "when": "view == novellized.manuscriptView",
          "group": "navigation@7"
        },
        {
          "command": "novellized.openSourceControl",
          "when": "view == novellized.manuscriptView",
          "group": "navigation@8"
        },
        {
          "command": "novellized.refreshSnapshotHistory",
          "when": "view == novellized.snapshotHistoryView",
          "group": "navigation@1"
        },
        {
          "command": "novellized.scmCommit",
          "when": "view == novellized.snapshotHistoryView",
          "group": "navigation@2"
        }
      ],
      "scm/title": [
        {
          "command": "novellized.scmCommit",
          "group": "navigation"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "novellized.scmDiff",
          "group": "inline@1"
        },
        {
          "command": "novellized.scmDiscard",
          "group": "inline@2"
        }
      ],
      "view/item/context": [
        {
          "command": "novellized.openCorkboard",
          "when": "view == novellized.manuscriptView && viewItem == chapter",
          "group": "inline@0"
        },
        {
          "command": "novellized.openCorkboard",
          "when": "view == novellized.manuscriptView && viewItem == chapter",
          "group": "7_modification@0"
        },
        {
          "command": "novellized.takeSnapshot",
          "when": "view == novellized.manuscriptView && viewItem == scene",
          "group": "inline@0"
        },
        {
          "command": "novellized.renameChapter",
          "when": "view == novellized.manuscriptView && viewItem == chapter",
          "group": "inline@1"
        },
        {
          "command": "novellized.renameChapter",
          "when": "view == novellized.manuscriptView && viewItem == chapter",
          "group": "7_modification@1"
        },
        {
          "command": "novellized.addScene",
          "when": "view == novellized.manuscriptView && viewItem == chapter",
          "group": "inline@2"
        },
        {
          "command": "novellized.addScene",
          "when": "view == novellized.manuscriptView && viewItem == chapter",
          "group": "7_modification@2"
        },
        {
          "command": "novellized.deleteChapter",
          "when": "view == novellized.manuscriptView && viewItem == chapter",
          "group": "9_cutcopypaste"
        },
        {
          "command": "novellized.renameScene",
          "when": "view == novellized.manuscriptView && viewItem == scene",
          "group": "inline@1"
        },
        {
          "command": "novellized.renameScene",
          "when": "view == novellized.manuscriptView && viewItem == scene",
          "group": "7_modification@1"
        },
        {
          "command": "novellized.addChapter",
          "when": "view == novellized.manuscriptView && viewItem == part",
          "group": "inline"
        },
        {
          "command": "novellized.openAsLiveView",
          "when": "view == novellized.manuscriptView && viewItem == scene",
          "group": "navigation@1"
        },
        {
          "command": "novellized.openAsRawMarkdown",
          "when": "view == novellized.manuscriptView && viewItem == scene",
          "group": "navigation@2"
        },
        {
          "command": "novellized.deleteScene",
          "when": "view == novellized.manuscriptView && viewItem == scene",
          "group": "9_cutcopypaste"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "novellized.manuscriptView",
        "contents": "No novel manuscript found in this workspace.\n[Create New Novel Project](command:novellized.createNewNovel)\n[Import from Word (.docx)](command:novellized.importDocx)"
      },
      {
        "view": "explorer",
        "contents": "Start your literary project with Novellized.\n[Create New Novel Project](command:novellized.createNewNovel)"
      }
    ],
    "keybindings": [
      {
        "command": "novellized.toggleZenMode",
        "key": "alt+z",
        "mac": "cmd+alt+z"
      }
    ],
    "themes": [
      {
        "label": "Novellized Warm Parchment",
        "uiTheme": "vs",
        "path": "./themes/warm-parchment.json"
      },
      {
        "label": "Novellized Midnight Candle",
        "uiTheme": "vs-dark",
        "path": "./themes/midnight-candle.json"
      },
      {
        "label": "Novellized E-Ink Monochrome",
        "uiTheme": "vs",
        "path": "./themes/e-ink.json"
      }
    ],
    "walkthroughs": [
      {
        "id": "novellized.welcome",
        "title": "Welcome to Novellized Studio",
        "description": "Your telemetry-free, distraction-free environment for novel writing.",
        "steps": [
          {
            "id": "novellized.step.create",
            "title": "Create a Novel Project",
            "description": "Initialize a professional novel structure (Part ➔ Chapter ➔ Scene) with character and worldbuilding bibles.\n[Create New Novel Project](command:novellized.createNewNovel)",
            "media": {
              "svg": "resources/icon.svg"
            },
            "completionEvents": [
              "onCommand:novellized.createNewNovel"
            ]
          },
          {
            "id": "novellized.step.write",
            "title": "Focus Mode & Typewriter Scrolling",
            "description": "Open any scene in Novellized Live View. Enjoy smooth typewriter scrolling and paragraph-dimming focus mode for deep flow state.",
            "media": {
              "svg": "resources/icon.svg"
            }
          },
          {
            "id": "novellized.step.preset",
            "title": "Apply Writer's Settings Preset",
            "description": "Turn off code line numbers, minimap, and syntax popups to make the editor feel like a pure novel writing app.\n[Apply Writer Preset](command:novellized.applyNovelistPreset)",
            "media": {
              "svg": "resources/icon.svg"
            },
            "completionEvents": [
              "onCommand:novellized.applyNovelistPreset"
            ]
          },
          {
            "id": "novellized.step.export",
            "title": "Export to EPUB & PDF",
            "description": "Compile your entire manuscript into a standard EPUB 3 ebook or publication-grade PDF in seconds.\n[Export as EPUB](command:novellized.exportEpub) | [Export as PDF](command:novellized.exportPdf)",
            "media": {
              "svg": "resources/icon.svg"
            },
            "completionEvents": [
              "onCommand:novellized.exportEpub",
              "onCommand:novellized.exportPdf"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "node esbuild.config.mjs --production",
    "compile": "tsc -noEmit",
    "watch": "node esbuild.config.mjs --watch",
    "build": "node esbuild.config.mjs --production",
    "package:ide": "node scripts/package-codium.mjs",
    "package:installer": "node scripts/build-installer.mjs",
    "package:all": "node scripts/package-codium.mjs && node scripts/build-installer.mjs"
  },
  "dependencies": {
    "@tiptap/core": "^2.11.5",
    "@tiptap/extension-bubble-menu": "^2.27.3",
    "@tiptap/extension-focus": "^2.27.3",
    "@tiptap/starter-kit": "^2.11.5",
    "isomorphic-git": "^1.42.2",
    "jszip": "^3.10.2",
    "mammoth": "^1.12.2",
    "marked": "^18.0.12",
    "tiptap-markdown": "^0.8.10"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/jszip": "^3.4.0",
    "@types/node": "^20.11.24",
    "@types/vscode": "^1.80.0",
    "esbuild": "^0.25.0",
    "pngjs": "^7.0.0",
    "rcedit": "^5.0.2",
    "typescript": "^5.3.3"
  }
}
